    <script src="<%=ResolveUrl("Scripts/JQueryUI/external/jquery/jquery.js")%>"></script>
    <script src="<%=ResolveUrl("Recursos/js/General.js") %>"></script>
    <script src="<%=ResolveUrl("Scripts/sweetalert2.all.min.js") %>"></script>
    <script src="Scripts/bootstrap.bundle.js"></script>
</body>
</html>
